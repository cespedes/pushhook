# Address to listen on (required)
listen 127.0.0.1:9000

# github|gitlab NAME SECRET COMMAND [ARGS...]
#
# GitHub: SECRET is the "Secret" of the webhook (content type application/json).
github example/website change-me /usr/local/bin/deploy-website.sh

# GitLab: SECRET is the "Signing token" of the webhook (starts with whsec_).
gitlab group/project whsec_Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWU= /usr/local/bin/deploy-project.sh --fast
