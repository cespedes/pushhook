#!/bin/sh
# Git post-receive hook: tell pushhook about every pushed ref, using the same
# request a GitHub push webhook would send.
#
# Install as hooks/post-receive in the bare repository (chmod +x) and edit the
# three settings below. It needs sh, openssl and curl.

URL=https://hooks.example.org/
REPO=example/website    # the NAME of the "github" line in the pushhook config
SECRET=change-me        # the SECRET of that same line

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

zero=0000000000000000000000000000000000000000

while read -r _old new ref; do
	# Nothing to deploy when a ref is deleted.
	[ "$new" = "$zero" ] && continue

	body=$(printf '{"ref":"%s","after":"%s","repository":{"full_name":"%s"}}' \
		"$(json_escape "$ref")" "$new" "$(json_escape "$REPO")")
	sig=$(printf '%s' "$body" | openssl dgst -sha256 -hmac "$SECRET" | sed 's/^.*= //')

	curl -fsS --max-time 10 -o /dev/null \
		-H 'Content-Type: application/json' \
		-H 'X-GitHub-Event: push' \
		-H "X-Hub-Signature-256: sha256=$sig" \
		--data-binary "$body" "$URL" ||
		echo "post-receive: could not notify pushhook about $ref" >&2
done
exit 0
