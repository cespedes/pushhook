#!/bin/sh
# Subversion post-commit hook: tell pushhook about every commit, using the
# same request a GitHub push webhook would send. Subversion has no branches
# at this level, so the ref is always "svn" and the commit is "r<revision>".
#
# Install as hooks/post-commit in the repository (chmod +x) and edit the
# three settings below. It needs sh, openssl and curl.

# Subversion runs hooks with an empty environment.
PATH=/usr/local/bin:/usr/bin:/bin

URL=https://hooks.example.org/
REPO=example/svn-project    # the NAME of the "github" line in the pushhook config
SECRET=change-me            # the SECRET of that same line

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

REV=$2    # $1 is the repository path

body=$(printf '{"ref":"svn","after":"r%s","repository":{"full_name":"%s"}}' \
	"$(json_escape "$REV")" "$(json_escape "$REPO")")
sig=$(printf '%s' "$body" | openssl dgst -sha256 -hmac "$SECRET" | sed 's/^.*= //')

curl -fsS --max-time 10 -o /dev/null \
	-H 'Content-Type: application/json' \
	-H 'X-GitHub-Event: push' \
	-H "X-Hub-Signature-256: sha256=$sig" \
	--data-binary "$body" "$URL" ||
	echo "post-commit: could not notify pushhook about r$REV" >&2
exit 0
